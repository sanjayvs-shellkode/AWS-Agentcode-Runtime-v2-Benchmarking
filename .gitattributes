# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation
*.md text diff=markdown
*.txt text

# Config files
*.json text
*.yaml text
*.yml text
*.toml text

# Binary files
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
